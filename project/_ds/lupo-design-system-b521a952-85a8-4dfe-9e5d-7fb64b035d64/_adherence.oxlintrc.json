{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/game/**",
              "ui_kits/lupo_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|disabled|loading|icon|fullWidth|type|style|key|ref|className|style|children)$/]",
        "message": "<ButtonPrimary> doesn't accept that prop. Declared props: children, onClick, disabled, loading, icon, fullWidth, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<ButtonPrimary> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|disabled|icon|fullWidth|type|style|key|ref|className|style|children)$/]",
        "message": "<ButtonSecondary> doesn't accept that prop. Declared props: children, onClick, disabled, icon, fullWidth, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondary'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<ButtonSecondary> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|sender|handle|time|subject|children|flags|style|key|ref|className|style|children)$/]",
        "message": "<EvidenceCard> doesn't accept that prop. Declared props: kind, sender, handle, time, subject, children, flags, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:sms|email|social|chat)$/]",
        "message": "<EvidenceCard> kind must be one of 'sms' | 'email' | 'social' | 'chat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='LupasCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|max|showNumber|size|style|key|ref|className|style|children)$/]",
        "message": "<LupasCounter> doesn't accept that prop. Declared props: count, max, showNumber, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LupasCounter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<LupasCounter> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MascotBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|emotion|mascotSrc|side|name|style|key|ref|className|style|children)$/]",
        "message": "<MascotBubble> doesn't accept that prop. Declared props: children, emotion, mascotSrc, side, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MascotBubble'] > JSXAttribute[name.name='emotion'] > Literal[value!=/^(?:neutral_alerta|feliz_acierto|preocupado_error|sorprendido_pista|celebrando_racha)$/]",
        "message": "<MascotBubble> emotion must be one of 'neutral_alerta' | 'feliz_acierto' | 'preocupado_error' | 'sorprendido_pista' | 'celebrando_racha'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MascotBubble'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<MascotBubble> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|caption|verdict|photo|onInvestigate|tilt|style|key|ref|className|style|children)$/]",
        "message": "<PolaroidNode> doesn't accept that prop. Declared props: state, caption, verdict, photo, onInvestigate, tilt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidNode'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:completado|actual|bloqueado)$/]",
        "message": "<PolaroidNode> state must be one of 'completado' | 'actual' | 'bloqueado'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidNode'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:verificado|falso|sospechoso)$/]",
        "message": "<PolaroidNode> verdict must be one of 'verificado' | 'falso' | 'sospechoso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressPathThread'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|bend|dashed|active|style|key|ref|className|style|children)$/]",
        "message": "<ProgressPathThread> doesn't accept that prop. Declared props: width, height, bend, dashed, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|animate|rotate|style|key|ref|className|style|children)$/]",
        "message": "<StampBadge> doesn't accept that prop. Declared props: variant, size, animate, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:verificado|falso|sospechoso)$/]",
        "message": "<StampBadge> variant must be one of 'verificado' | 'falso' | 'sospechoso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StampBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakFlame'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|size|style|key|ref|className|style|children)$/]",
        "message": "<StreakFlame> doesn't accept that prop. Declared props: days, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakFlame'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StreakFlame> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
